              <input type="checkbox" name="categoryIDs[]" value="#(cat.id)">
              #(cat.name)
            </label><br>
          #endfor
        #else:
          <p>No categories available.</p>
        #endif
      </label>
      <button type="submit">Create</button>
    </form>
    <a href="/products">Back to Index</a>
  #endexport
#endextend
